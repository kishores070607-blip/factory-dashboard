# Dashboard Platform — Environment Configuration
# Copy to .env and adjust values

# Server
PORT=3000
HOST=0.0.0.0

# Session
SESSION_SECRET=change-me-to-a-random-string

# Database
DB_PATH=./data/dashboard.db

# Staleness thresholds (seconds)
STALE_THRESHOLD_S=30
OFFLINE_THRESHOLD_S=120

# Staleness check interval (ms)
STALENESS_CHECK_INTERVAL_MS=10000

# Simulator defaults
SIM_DEVICE_COUNT=3
SIM_EVENT_INTERVAL_MS=2000
SIM_HEALTH_INTERVAL_MS=10000
