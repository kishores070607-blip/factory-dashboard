{
  "name": "dashboard-platform",
  "version": "1.0.0",
  "description": "Batch B — Dashboard & Data Platform for Raspberry Pi 4",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "simulate": "node simulator/simulate.js",
    "simulate:duplicate": "node simulator/simulate.js --duplicate",
    "simulate:delay": "node simulator/simulate.js --delay",
    "simulate:burst": "node simulator/simulate.js --burst",
    "simulate:fault": "node simulator/simulate.js --fault",
    "test": "node --test tests/**/*.test.js",
    "migrate": "node backend/persistence/migrate.js",
    "backup": "cp data/dashboard.db data/backup-$(date +%Y%m%d-%H%M%S).db"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "bcrypt": "^5.1.1",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "dotenv": "^16.4.5",
    "uuid": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
